<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="Info" style="flex-grow: 1; align-self: flex-start; flex-direction: column; align-items: stretch; width: 195px; justify-content: space-evenly; align-content: auto;">
        <ui:Label text="Control Mode : " name="ControlMode" binding-path="" selectable="false" focusable="false" style="flex-direction: row-reverse; align-items: flex-end; justify-content: space-evenly; -unity-text-align: upper-left; width: 223px;">
            <ui:Label text="param" parse-escape-sequences="false" enabled="true" binding-path="controlMode" name="ControlMode_Param" picking-mode="Position" style="white-space: nowrap; -unity-text-align: upper-left; height: 22px; width: 50px; text-overflow: clip; letter-spacing: 0; align-items: auto; align-content: auto; align-self: auto; justify-content: flex-start; flex-direction: row-reverse;"/>
        </ui:Label>
        <ui:Label text="Agent Status : " name="AgentStatus" style="align-items: flex-end; align-content: auto; flex-direction: row-reverse; justify-content: center; -unity-text-align: upper-left; width: 218px;">
            <ui:Label text="param" name="AgentStatus_param" binding-path="agentStatus" style="-unity-text-align: upper-left;"/>
        </ui:Label>
    </ui:VisualElement>
    <ui:VisualElement name="Control" style="flex-grow: 1; align-content: auto; align-items: stretch; align-self: flex-start; flex-direction: column;">
        <ui:Button text="Set Player Control" name="PlayerControlButton"/>
        <ui:Button text="Set AI Control" name="AgentControlButton"/>
        <ui:Button text="Toggle AI" name="ToggleAIButton"/>
    </ui:VisualElement>
</ui:UXML>
