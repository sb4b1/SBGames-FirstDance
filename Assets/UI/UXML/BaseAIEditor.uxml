<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="Label" style="flex-grow: 1; position: relative; height: 110px; width: 381px; margin-bottom: 8px;">
        <ui:Label text="Current Goal : " name="CurrentGoal" style="position: absolute; top: 0; left: 0; width: 88px; height: 17px;"/>
        <ui:Label text="Param" name="CurrentGoalParam" enable-rich-text="false" binding-path="currentGoalKey" parse-escape-sequences="false" style="position: absolute; top: 0; left: 91px; width: 260px; height: 17px; -unity-text-align: upper-left; white-space: nowrap;"/>
        <ui:Label text="CurrentTarget : " name="CurrentEnemy" style="position: absolute; top: 18px; left: 0; height: 17px; width: 88px;"/>
        <ui:Label text="Label" name="CurrentEnemyParam" binding-path="currentTarget" style="position: absolute; top: 18px; left: 91px; width: 260px; height: 17px;"/>
        <ui:Label text="Current Skill : " name="CurrentSkill" style="position: absolute; top: 36px; left: 0; height: 17px; width: 88px;"/>
        <ui:Label text="None" name="CurrentSkillParam" binding-path="currentSkillKey" style="position: absolute; top: 36px; left: 91px; width: 260px; height: 17px;"/>
        <ui:ProgressBar value="22" title="Threat Level" name="ThreatLevel" binding-path="threatLevel" style="position: absolute; top: 56px; left: 0; width: 260px;"/>
        <ui:ProgressBar value="22" title="Fear Level" name="FearLevel" binding-path="fearLevel" style="position: absolute; top: 83px; left: 0; width: 260px;"/>
    </ui:VisualElement>
</ui:UXML>
