<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="Label" style="flex-grow: 1; flex-direction: row; position: relative; height: 337px; width: 381px;">
        <ui:Label text="Current Goal : " name="CurrentGoal" style="align-content: auto; flex-direction: row; align-self: auto; align-items: auto; justify-content: flex-start; width: 83px; height: 17px;"/>
        <ui:Label text="Param" name="CurrentGoalParam" enable-rich-text="false" binding-path="currentGoalKey" parse-escape-sequences="false" style="align-content: auto; justify-content: flex-start; -unity-text-align: upper-left; white-space: nowrap; width: 184px; height: 18px;"/>
        <ui:Label text="CurrentTarget : " name="CurrentEnemy" style="position: absolute; top: 18px; left: 0; height: 17px; width: 88px;"/>
        <ui:Label text="Label" name="CurrentEnemyParam" binding-path="currentTarget" style="position: absolute; top: 19px; left: 91px; width: 114px;"/>
        <ui:ProgressBar value="22" title="Threat Level" name="ThreatLevel" binding-path="threatLevel" style="position: absolute; top: 52px; left: 0; width: 260px;"/>
        <ui:ProgressBar value="22" title="Fear Level" name="FearLevel" binding-path="fearLevel" style="position: absolute; top: 79px; left: 0; width: 260px;"/>
    </ui:VisualElement>
</ui:UXML>
